{
	"schemaVersion": 1,
	"id": "lootr-polymer-patch",
	"version": "${version}",
	"name": "Polymer Patch for Lootr",
	"description": "Server-side-only Lootr: loot chests, barrels, shulkers, pots and trophies are virtualised so unmodded clients can see and use them.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"eu.pb4.lootrpatch.LootrPolymerPatch"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-core": ">=0.16.0",
		"polymer-resource-pack": ">=0.16.0",
		"polymer-virtual-entity": ">=0.16.0",
		"lootr": ">=1.23.0"
	}
}
